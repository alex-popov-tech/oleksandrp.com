---
/**
 * The animated text stream in a file view's right margin.
 *
 * Unlike a diagram this is not content: the layout renders it as a column beside #buffer
 * rather than through the buffer slot, so numberLines never sees it. Nothing is drawn here —
 * the strip's height is whatever the pane allows, which only the browser knows — so it starts
 * hidden and scripts/stream.ts brings it up.
 *
 * It carries `page-effect` from the server, like the diagrams and the README session do: this
 * page has an animation of its own, so the train stays in the shed whether or not the strip
 * has room to draw today.
 */
import type { StreamId } from '../lib/streams';

interface Props { id: StreamId }
const { id } = Astro.props;
---
<margin-stream class="stream page-effect" data-id={id} aria-hidden="true" hidden></margin-stream>
