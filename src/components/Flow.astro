---
/**
 * The acapulko data-flow diagram, as a block of buffer lines. The first frame is rendered
 * here so the diagram is a real picture without JavaScript; scripts/flow.ts takes over and
 * animates it. Rows are `.ln` like every other buffer line, so they get numbered too.
 *
 * The bulb and the paper plane are SVG positioned over the character grid: they carry
 * detail no 7x6 block of box-drawing can. Everything else stays text.
 */
import { NODE_BOX, renderFrame, type Cell, type Role } from '../lib/flow';

/** Group a row into runs of the same colour so we ship spans per run, not per cell. */
function runs(row: Cell[]): { text: string; color: Role; op: number }[] {
  const out: { text: string; color: Role; op: number }[] = [];
  for (const cell of row) {
    const last = out[out.length - 1];
    if (last && last.color === cell.color && last.op === cell.op) last.text += cell.ch;
    else out.push({ text: cell.ch, color: cell.color, op: cell.op });
  }
  return out;
}

const box = (b: { row: number; col: number; cols: number; rows: number }) =>
  `left:${b.col}ch;top:calc(${b.row} * var(--lh));width:${b.cols}ch;height:calc(${b.rows} * var(--lh))`;

const first = renderFrame(0);
---
<ascii-flow class="flow" data-on={first.bulbOn ? '' : undefined}>
  <div class="flow-grid">
    {first.grid.map((row) => (
      <div class="ln"><div class="tx flow-row">{runs(row).map((r) => (
        <span class:list={[`c-${r.color}`]} style={r.op === 1 ? undefined : `opacity:${r.op}`}>{r.text}</span>
      ))}</div></div>
    ))}

    <svg class="flow-node plane" style={box(NODE_BOX.telegram)} viewBox="0 0 48 44" aria-hidden="true">
      <path d="M3 21.5 45 4 37 40 25.5 31.5 20 39.5 18.5 30Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M18.5 30 45 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M18.5 30 25.5 31.5" fill="none" stroke="currentColor" stroke-width="1.6" />
    </svg>

    <svg class="flow-node bulb" style={box(NODE_BOX.bulb)} viewBox="0 0 44 60" aria-hidden="true">
      <g class="rays" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M22 2v5" /><path d="M8 7l3 4" /><path d="M36 7l-3 4" />
        <path d="M2 22h5" /><path d="M42 22h-5" />
      </g>
      <path class="glass" d="M22 10a13 13 0 0 1 8 23.2c-1.5 1.2-2.3 2.6-2.5 4.3h-11c-.2-1.7-1-3.1-2.5-4.3A13 13 0 0 1 22 10Z"
            fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      <path class="filament" d="M18.5 30c0-4 2-4 3.5-7 1.5 3 3.5 3 3.5 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M16.5 41.5h11M17.5 46h9M19.5 50.5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  </div>
</ascii-flow>
