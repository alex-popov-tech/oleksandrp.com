---
/**
 * A Nerd Font glyph. The codepoints are Private Use Area, so they only render with the
 * subset shipped in src/fonts (see README for how it is regenerated). Names match the
 * icon sets neovim users see: seti-* for languages, custom-* for folders, oct/cod for the rest.
 */
interface Props { name: string }
const { name } = Astro.props;

const GLYPH: Record<string, string> = {
  'folder': '',        // custom-folder
  'folder-open': '',   // custom-folder_open
  'branch': '',        // oct-git_branch
  'go': '',            // seti-go2, the GO wordmark
  'lua': '',           // seti-lua
  'ts': '',            // seti-typescript
  'js': '',            // seti-javascript
  'sh': '',            // oct-terminal
  'md': '',            // oct-markdown
  'readme': '',        // oct-markdown, same white as md
  'pdf': '',           // seti-pdf
};

const glyph = GLYPH[name] ?? GLYPH.md;
---
<span class:list={['nf', `nf-${name}`]} aria-hidden="true">{glyph}</span>
