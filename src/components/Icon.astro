---
interface Props { name: string }
const { name } = Astro.props;

const stroke = (color: string, body: string, w = 1.5) =>
  `<g fill="none" stroke="${color}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round">${body}</g>`;

/** A rounded language badge with two letters, the way seti/devicon renders TS and JS. */
const badge = (fill: string, ink: string, text: string) =>
  `<rect x="2.5" y="2.5" width="19" height="19" rx="4" fill="${fill}"/>` +
  `<text x="12.4" y="16.6" text-anchor="middle" font-family="inherit" font-size="10.5" font-weight="700" fill="${ink}">${text}</text>`;

const FOLDER = '<path d="M3.4 7.2a1.6 1.6 0 0 1 1.6-1.6h3.3l1.9 2.1h8.2a1.6 1.6 0 0 1 1.6 1.6v8.5a1.6 1.6 0 0 1-1.6 1.6H5a1.6 1.6 0 0 1-1.6-1.6z"/>';
const FOLDER_OPEN =
  '<path d="M3.4 17.8V7.2A1.6 1.6 0 0 1 5 5.6h3.3l1.9 2.1h6.3a1.6 1.6 0 0 1 1.6 1.6v1.1"/>' +
  '<path d="M3.4 17.8l2.5-6.4a1 1 0 0 1 .93-.64h14.1a.6.6 0 0 1 .56.82l-2.2 5.6a1 1 0 0 1-.93.64H4a.6.6 0 0 1-.56-.82z"/>';
const FILE = '<path d="M13.8 3.2H7.2a1.7 1.7 0 0 0-1.7 1.7v14.2a1.7 1.7 0 0 0 1.7 1.7h9.6a1.7 1.7 0 0 0 1.7-1.7V7.8z"/><path d="M13.6 3.4v4.2a.8.8 0 0 0 .8.8h4"/>';
const BRANCH = '<circle cx="7" cy="5.6" r="2.1"/><circle cx="7" cy="18.4" r="2.1"/><circle cx="17" cy="9.4" r="2.1"/><path d="M17 11.5v1.2a3.1 3.1 0 0 1-3.1 3.1H7"/><path d="M7 7.7v8.6"/>';
const MARKDOWN = '<rect x="2.4" y="6.2" width="19.2" height="11.6" rx="2.4"/><polyline points="6,15.2 6,8.8 9,12.2 12,8.8 12,15.2"/><path d="M16.2 8.8v4.6"/><polyline points="14.2,12.2 16.2,14.6 18.2,12.2"/>';
const SHELL = '<rect x="3" y="5" width="18" height="14" rx="2.6"/><polyline points="7.4,10.2 9.9,12.4 7.4,14.6"/><path d="M12.6 15h4.2"/>';

/** The gopher: body, ears, eyes with pupils, muzzle. */
const GOPHER =
  '<ellipse cx="7.4" cy="6.6" rx="2" ry="2.3" fill="#00ADD8"/>' +
  '<ellipse cx="16.6" cy="6.6" rx="2" ry="2.3" fill="#00ADD8"/>' +
  '<ellipse cx="12" cy="13.9" rx="6.5" ry="7.3" fill="#00ADD8"/>' +
  '<circle cx="9.4" cy="11" r="2.9" fill="#fff"/><circle cx="14.6" cy="11" r="2.9" fill="#fff"/>' +
  '<circle cx="10.3" cy="11.2" r="1.25" fill="#12121c"/><circle cx="15.5" cy="11.2" r="1.25" fill="#12121c"/>' +
  '<ellipse cx="12" cy="15.4" rx="2" ry="1.5" fill="#fdf2e3"/>' +
  '<path d="M11 15.1h2" stroke="#12121c" stroke-width="0.9" stroke-linecap="round"/>';

/** The Lua logo: a sphere with an orbit and the satellite dot. */
const LUA =
  '<circle cx="10.6" cy="13.4" r="6.6" fill="#2c2d72"/>' +
  '<circle cx="10.6" cy="13.4" r="6.6" fill="none" stroke="#89b4fa" stroke-width="1.4"/>' +
  '<circle cx="8.2" cy="10.8" r="1.9" fill="#89b4fa"/>' +
  '<circle cx="18.4" cy="6.2" r="2.7" fill="#2c2d72" stroke="#89b4fa" stroke-width="1.4"/>';

const ICONS: Record<string, string> = {
  folder: stroke('var(--accent)', FOLDER),
  'folder-open': stroke('var(--accent)', FOLDER_OPEN),
  file: stroke('var(--blue)', FILE),
  branch: stroke('var(--mauve)', BRANCH),
  go: GOPHER,
  lua: LUA,
  ts: badge('#3178c6', '#ffffff', 'TS'),
  js: badge('#f7df1e', '#12121c', 'JS'),
  sh: stroke('var(--green)', SHELL),
  md: stroke('var(--dim)', MARKDOWN),
  readme: stroke('var(--accent)', MARKDOWN),
  pdf: stroke('var(--peach)', FILE),
  arrow: '<path d="M0 0 L9 11 L0 22 Z" fill="var(--accent)"/>',
};

const body = ICONS[name] ?? ICONS.md;
const arrow = name === 'arrow';
---
<svg viewBox={arrow ? '0 0 9 22' : '0 0 24 24'} width={arrow ? 9 : 15} height={arrow ? 22 : 15} aria-hidden="true" set:html={body} />
